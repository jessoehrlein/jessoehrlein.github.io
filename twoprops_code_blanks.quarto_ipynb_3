    "  setup:\n",
    "    - library(ggplot2)\n",
    "    - library(dplyr)\n",
    "    - library(infer)\n",
    "    - library(openintro)\n",
    "---\n",
    "\n",
    "## Dataset & Null Hypothesis Sampling Distribution\n",
    "\n",
    "You'll work with a dataset called `cpr` about patients who had heart attacks, were given CPR, and then were admitted to the hospital. Once in the hospital, they were either given blood thinners (`treatment` group) or not (`control` group). The experiment then measured whether they survived at least 24 hours.\n",
    "\n",
    "Run the code below to see a random 10 rows of the dataset.\n",
    "```{code-blanks}\n",
    "slice_sample(cpr, n = 10)\n",
    "```\n",
    "\n",
    "Answer Questions 5-10 of your packet, then **stop** and check in with Dr. O or Aidan.\n",
    "\n",
    "Then use those responses to fill in this code to generate your null hypothesis sampling distribution (or \"null distribution\" for short).\n",
    "\n",
    "```{code-blanks}\n",
    "#| blank:\n",
    "#|   target: outcome\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: group\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: survived\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: \"diff in props\"\n",
    "#|   prefill: true\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: treatment\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: control\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "\n",
    "null_dist <- cpr |>\n",
    "  specify(response = outcome, explanatory = group, success = \"survived\") |>\n",
    "  hypothesize(null = \"independence\") |>\n",
    "  generate(reps = 5000, type = \"permute\") |>\n",
    "  calculate(stat = \"diff in props\", order = c(\"treatment\",\"control\"))\n",
    "\n",
    "visualize(null_dist)\n",
    "\n",
    "```\n",
    "\n",
    "Answer Question 11 in the packet.\n",
    "\n",
    "## Investigating the Sample\n",
    "\n",
    "Answer Questions 12-14 in your packet, then fill in the code below to check your work.\n",
    "\n",
    "```{code-blanks}\n",
    "#| blank:\n",
    "#|   target: outcome\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: group\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: survived\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: \"diff in props\"\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: treatment\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: control\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "\n",
    "sample_stat <- cpr |>\n",
    "  specify(response = outcome, explanatory = group, success = survived) |>\n",
    "  calculate(stat = \"diff in props\", order = c(\"treatment\",\"control\"))\n",
    "\n",
    "sample_stat\n",
    "\n",
    "```\n",
    "\n",
    "**Stop** and check in with Dr. O or Aidan here.\n",
    "\n",
    "## Finding the p-value\n",
    "\n",
    "Answer Question 16 in your packet, then fill in the code below to answer Question 17.\n",
    "\n",
    "```{code-blanks}\n",
    "#| blank:\n",
    "#|   target: right\n",
    "#|   prefill: false\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "#| blank:\n",
    "#|   target: sample_stat\n",
    "#|   prefill: true\n",
    "#|   occurrence: 1\n",
    "#|   match: token\n",
    "\n",
    "null_dist |>\n",
    "  visualize() + \n",
    "  shade_p_value(sample_stat, direction = \"right\")\n",
    "\n",
    "```\n",
    "\n",
    "Now fill in the code below to answer Question 18.\n",
    "\n",
    "```{code-blanks}\n",
    "#| blank:\n",
