    "---\n",
    "title: Hypothesis Testing for Two Proportions\n",
    "format: html\n",
    "filters:\n",
    "  - code-blanks\n",
    "\n",
    "code-blanks:\n",
    "  progressive-reveal: true\n",
    "  packages:\n",
    "    - dplyr\n",
    "    - ggplot2\n",
    "    - infer\n",
